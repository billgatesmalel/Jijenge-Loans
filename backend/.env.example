# ============================================================
# Jijenge Loans - Backend Environment Variables
# ============================================================

# ── Neon Serverless PostgreSQL Database (Prisma ORM) ─────────
# Pooled connection string (with -pooler endpoint & sslmode=require) for app queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection string (without pooler) required for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── JWT Authentication Secrets ──────────────────────────────
JWT_SECRET="jijenge_loans_super_secure_jwt_secret_min32chars_production"
SUPER_ADMIN_USER="admin@jijengeloans.co.ke"
SUPER_ADMIN_PASS="Jijenge2026!SecureAdminPass"

# ── PalPluss M-Pesa Payment Gateway ─────────────────────────
PALPLUSS_API_KEY="pk_live_jijenge_palpluss_api_key_here"
PALPLUSS_CHANNEL_ID="1"
PALPLUSS_CALLBACK_BASE_URL="https://jijengeloans.co.ke"
PALPLUSS_WEBHOOK_SECRET="generate_random_secret_string_here"

# ── Capcom6 Android SMS Gateway (sms-gate.app) ───────────────
SMSGATEWAY_USERNAME="your_sms_gateway_user"
SMSGATEWAY_PASSWORD="your_sms_gateway_password"
SMSGATEWAY_BASE_URL="https://api.sms-gate.app/3rdparty/v1"
SMSGATEWAY_SIM_NUMBER=1

# ── Node Server Config ──────────────────────────────────────
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN="http://localhost:3000"
