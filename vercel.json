{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "jijenge-loans-backend": {
      "root": "backend",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm install --include=dev && npm run prisma:generate && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "jijenge-loans-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
